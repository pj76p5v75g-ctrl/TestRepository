//練習02
@startuml
Main -> calculate :データを計算する
activate calculate

calculate -> getInput :入力データ要求
activate getInput
getInput --> calculate :入力データ
deactivate getInput

calculate --> Main :計算結果
deactivate calculate

Main -->: 結果
activate Main
deactivate Main
@enduml

